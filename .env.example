# ==========================================
# EXAM MANAGEMENT SYSTEM - ROOT / DOCKER ENV TEMPLATE
# (Sao chép file này thành .env trước khi chạy Docker hoặc dev)
# ==========================================

# 1. Cấu hình Cổng & Mạng
PORT=3001
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# 2. Cơ sở dữ liệu PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_db_test?schema=public"

# 3. Bảo mật & Xác thực JWT
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"
COOKIE_SECURE="false"
FILE_SIGNING_SECRET="replace-with-a-long-random-secret"
AUDIT_HASH_SECRET="replace-with-a-long-random-secret"
AUDIT_ARCHIVE_ROOT=""

# 4. Cấu hình Email SMTP (Gửi mật khẩu, thông báo, liên hệ)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
CONTACT_RECIPIENT="your_email@gmail.com"

# 5. Đăng nhập Google OAuth (Tùy chọn)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"
GOOGLE_OAUTH_TIMEOUT_MS="10000"

# 6. Tích hợp AI (Trợ lý chấm thi, sinh đề & tối ưu câu hỏi)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_TIMEOUT_MS=180000
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 7. Kiểm soát Tải (Rate Limiting)
RATE_LIMIT_ENABLED="false"

# 8. Hệ thống Sao lưu & Khôi phục (Backup & Disaster Recovery)
BACKUP_WORKER_ENABLED="false"
BACKUP_CONFIG_ENCRYPTION_KEY="replace_with_a_random_secret_at_least_32_characters"
BACKUP_SCHEDULE="02:00"
BACKUP_TIMEZONE="Asia/Ho_Chi_Minh"
BACKUP_INTERVAL_DAYS=1
BACKUP_MAX_RETENTION=10
BACKUP_RETENTION_DAILY="14"
BACKUP_RETENTION_WEEKLY="8"
BACKUP_RETENTION_MONTHLY="12"
BACKUP_LOCK_TIMEOUT_MS="7200000"
BACKUP_LOCAL_ROOT="backup-runtime/primary"
BACKUP_SECONDARY_ROOT="backup-runtime/mirror_backup"
BACKUP_UPLOADS_ROOT=""
STAGING_DATABASE_URL=""
BACKUP_STAGING_UPLOADS_ROOT=""
BACKUP_ALLOW_PRODUCTION_RESTORE="false"

# 9. Lưu trữ Đám mây S3 / MinIO (Tùy chọn)
BACKUP_STORAGE_ENDPOINT=""
BACKUP_STORAGE_REGION="us-east-1"
BACKUP_STORAGE_BUCKET=""
BACKUP_STORAGE_PREFIX="exam-system"
BACKUP_STORAGE_ACCESS_KEY=""
BACKUP_STORAGE_SECRET_KEY=""
BACKUP_STORAGE_FORCE_PATH_STYLE="false"
BACKUP_STORAGE_SSE="AES256"
