PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_db_test?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"
COOKIE_SECURE="false"
CORS_ORIGINS="http://localhost:3000"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_TIMEOUT_MS=180000
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Gmail SMTP dùng cho tính năng "Gửi yêu cầu hỗ trợ" (Trang Liên hệ)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
CONTACT_RECIPIENT="your_email@gmail.com"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"
BACKUP_WORKER_ENABLED="false"
BACKUP_STORAGE_BUCKET=""
BACKUP_STORAGE_ACCESS_KEY=""
BACKUP_STORAGE_SECRET_KEY=""
BACKUP_STORAGE_ENDPOINT=""
BACKUP_STORAGE_REGION="us-east-1"
BACKUP_STORAGE_PREFIX="exam-system"
BACKUP_STORAGE_FORCE_PATH_STYLE="false"
BACKUP_STORAGE_SSE="AES256"
BACKUP_LOCAL_ROOT=""
BACKUP_SECONDARY_ROOT=""
BACKUP_UPLOADS_ROOT=""
BACKUP_TIMEZONE="Asia/Ho_Chi_Minh"
BACKUP_SCHEDULE="02:00"
BACKUP_RETENTION_DAILY="14"
BACKUP_RETENTION_WEEKLY="8"
BACKUP_RETENTION_MONTHLY="12"
STAGING_DATABASE_URL=""
BACKUP_STAGING_UPLOADS_ROOT=""
BACKUP_ALLOW_PRODUCTION_RESTORE="false"
BACKUP_PG_DUMP_PATH="C:/Program Files/PostgreSQL/17/bin/pg_dump.exe"
BACKUP_PG_RESTORE_PATH="C:/Program Files/PostgreSQL/17/bin/pg_restore.exe"
