// Prisma Schema for Student Exam Management System (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  ESSAY
}
enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}
enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
}
enum QuestionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}
enum QuestionHistoryAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  ARCHIVE
  DUPLICATE
  RESTORE
  DELETE
  BULK_UPDATE
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String   @unique
  role      String   @default("STUDENT")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  teacher Teacher?

  createdQuestions  Question[]        @relation("UserQuestions")
  approvedQuestions Question[]        @relation("ApprovedQuestions")
  createdExamPapers ExamPaper[]       @relation("UserExamPapers")
  questionHistories QuestionHistory[] @relation("QuestionHistoryActor")
  auditLogs         AuditLog[]         @relation("AuditLogActor")

  @@map("users")
}

model Department {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  classes  Class[]
  teachers Teacher[]
  subjects Subject[]

  @@map("departments")
}

model Class {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  students Student[]

  @@map("classes")
}

model Student {
  id          Int      @id @default(autoincrement())
  studentCode String   @unique
  fullName    String
  gender      String
  dateOfBirth DateTime
  email       String
  phone       String?
  classId     Int
  class       Class    @relation(fields: [classId], references: [id])
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentSubjects  StudentSubject[]
  examRoomStudents ExamRoomStudent[]

  @@map("students")
}

model Teacher {
  id           Int        @id @default(autoincrement())
  teacherCode  String     @unique
  fullName     String
  degree       String
  email        String
  phone        String?
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  supervisors ExamSupervisor[]

  @@map("teachers")
}

model Subject {
  id           Int        @id @default(autoincrement())
  subjectCode  String     @unique
  subjectName  String
  credits      Int
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  studentSubjects StudentSubject[]
  examSchedules   ExamSchedule[]
  questions       Question[]
  chapters        Chapter[]

  @@map("subjects")
}

model Chapter {
  id String @id @default(uuid())
  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  code String
  name String
  order Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions Question[]

  @@unique([subjectId, code])
  @@unique([subjectId, order])
  @@map("chapters")
}

model StudentSubject {
  id         Int     @id @default(autoincrement())
  studentId  Int
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  Int
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester   String
  schoolYear String
  status     String  @default("ELIGIBLE")

  @@map("student_subjects")
}

model ExamPeriod {
  id         Int      @id @default(autoincrement())
  name       String
  semester   String
  schoolYear String
  startDate  DateTime
  endDate    DateTime
  status     String   @default("UPCOMING")

  examSchedules ExamSchedule[]

  @@map("exam_periods")
}

model ExamSchedule {
  id           Int        @id @default(autoincrement())
  examPeriodId Int
  examPeriod   ExamPeriod @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)
  subjectId    Int
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examDate     DateTime
  startTime    String
  endTime      String
  examType     String     @default("TRAC_NGHIEM")
  status       String     @default("SCHEDULED")
  note         String?

  examScheduleRooms ExamScheduleRoom[]
  examPapers        ExamPaper[]

  @@map("exam_schedules")
}

model ExamRoom {
  id       Int    @id @default(autoincrement())
  roomCode String @unique
  roomName String
  building String
  capacity Int
  roomType String @default("THI_LY_THUYET")
  status   String @default("AVAILABLE")

  examScheduleRooms ExamScheduleRoom[]

  @@map("exam_rooms")
}

model ExamScheduleRoom {
  id             Int          @id @default(autoincrement())
  examScheduleId Int
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  roomId         Int
  room           ExamRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  examRoomStudents ExamRoomStudent[]
  supervisors      ExamSupervisor[]

  @@map("exam_schedule_rooms")
}

model ExamRoomStudent {
  id                 Int              @id @default(autoincrement())
  examScheduleRoomId Int
  examScheduleRoom   ExamScheduleRoom @relation(fields: [examScheduleRoomId], references: [id], onDelete: Cascade)
  studentId          Int
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examNumber         String
  seatNumber         Int
  status             String           @default("ASSIGNED")

  @@map("exam_room_students")
}

model ExamSupervisor {
  id                 Int              @id @default(autoincrement())
  examScheduleRoomId Int
  examScheduleRoom   ExamScheduleRoom @relation(fields: [examScheduleRoomId], references: [id], onDelete: Cascade)
  teacherId          Int
  teacher            Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role               String           @default("SUPERVISOR_1")
  note               String?

  @@map("exam_supervisors")
}

model Question {
  id                String @id @default(uuid())
  code              String @unique
  subjectId         Int
  subject           Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapterId         String
  chapter           Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  content           String
  normalizedContent String
  type              QuestionType
  difficulty        QuestionDifficulty @default(MEDIUM)
  bloomLevel        BloomLevel @default(UNDERSTAND)
  score             Float    @default(0.25)
  explanation       String?
  keywords          String?
  status            QuestionStatus @default(DRAFT)
  rejectionReason   String?
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  approvedAt        DateTime?
  archivedAt        DateTime?
  createdById       Int
  createdBy         User     @relation("UserQuestions", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById      Int?
  approvedBy        User?    @relation("ApprovedQuestions", fields: [approvedById], references: [id], onDelete: SetNull)

  options            QuestionOption[]
  examPaperQuestions ExamPaperQuestion[]
  histories          QuestionHistory[]
  statistic          QuestionStatistic?

  @@index([subjectId, chapterId, status])
  @@index([createdById, createdAt])
  @@map("questions")
}

model QuestionHistory {
  id          String @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  action      QuestionHistoryAction
  oldData     Json?
  newData     Json?
  note        String?
  createdAt   DateTime @default(now())
  changedById Int
  changedBy   User     @relation("QuestionHistoryActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([questionId, createdAt])
  @@map("question_histories")
}

model QuestionOption {
  id String @id @default(uuid())
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label String
  content String
  isCorrect Boolean @default(false)
  order Int

  @@unique([questionId, order])
  @@map("question_options")
}

model QuestionStatistic {
  id String @id @default(uuid())
  questionId String @unique
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  usedCount Int @default(0)
  totalAnswers Int @default(0)
  correctAnswers Int @default(0)
  lastUsedAt DateTime?
  updatedAt DateTime @updatedAt
  @@map("question_statistics")
}

model ExamPaper {
  id              Int          @id @default(autoincrement())
  examScheduleId  Int
  examSchedule    ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  paperCode       String
  title           String
  durationMinutes Int
  totalScore      Float
  createdById     Int
  createdBy       User         @relation("UserExamPapers", fields: [createdById], references: [id], onDelete: Cascade)

  questions ExamPaperQuestion[]

  @@map("exam_papers")
}

model ExamPaperQuestion {
  id            Int       @id @default(autoincrement())
  examPaperId   Int
  examPaper     ExamPaper @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionOrder Int
  score         Float
  usedAt        DateTime  @default(now())

  @@map("exam_paper_questions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     Int?
  actor       User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
